# Odoo.sh SSH — copy the values from the branch's "SSH" button in Odoo.sh
#   ssh 25004381@myorg-myrepo-staging-25004381.dev.odoo.com
#       ^ user = build ID  ^ host
# The build ID changes with every new build of the branch: update both values after a rebuild.
ODOO_SH_SSH_HOST=myorg-myrepo-staging-25004381.dev.odoo.com
ODOO_SH_SSH_USER=25004381
ODOO_SH_SSH_PORT=22

# Private key whose public half is in your Odoo.sh profile (GitHub avatar > Profile > Add a key manually).
# Must NOT have a passphrase (BatchMode): use a dedicated key for this server.
ODOO_SH_SSH_KEY_PATH=/keys/id

# Host key checking: accept-new (TOFU, default) or yes (strict, requires a populated known_hosts)
ODOO_SH_SSH_STRICT_HOST_KEY=accept-new
ODOO_SH_SSH_KNOWN_HOSTS=

# Database for execute_odoo_shell (empty = the build's configured database)
ODOO_SH_DATABASE=

# true (default): only read tools are exposed. false: also shell, file and git write tools.
ODOO_SH_READ_ONLY=true

SSH_TIMEOUT=30000
LOG_LEVEL=info
